{
  "manifest_version": 3,
  "name": "Genesis Recruitment RPA",
  "version": "0.1.17",
  "description": "Boss-first recruitment automation extension for Genesis Nexus.",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Genesis Recruitment RPA",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/injected.js"],
      "matches": ["https://www.zhipin.com/*"]
    }
  ]
}
